---
// The TL;DR box and its stat tiles.
//
//   <Tldr stats={[{ label: 'Papers', value: '2', note: "OSDI '26 · SOSP '26" }]}>
//     Markdown paragraphs.
//   </Tldr>
interface Stat {
  label: string;
  value: string;
  note?: string;
}
interface Props {
  stats?: Stat[];
  title?: string;
}
const { stats = [], title = 'TL;DR' } = Astro.props;
---

<section id="tldr" class="scroll-mt-20 pt-14">
  <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="prose-measure border border-rule bg-paper-raised p-6">
          <h2 class="font-mono text-[11.5px] tracking-[0.12em] text-accent uppercase">{title}</h2>
          <div class="post-prose post-prose-tight mt-4">
            <slot />
          </div>
        </div>
      </div>
      {stats.length > 0 && (
        <div class="lg:col-span-5">
          <div data-reveal>
            <dl class="grid grid-cols-2 gap-px border border-rule bg-rule">
              {stats.map((s) => (
                <div class="flex flex-col gap-1 bg-paper-raised p-5">
                  <dt class="font-mono text-[10.5px] tracking-[0.12em] text-ink-faint uppercase">{s.label}</dt>
                  <dd class="font-mono text-[1.7rem] leading-none font-medium tracking-tight text-ink [font-variant-numeric:proportional-nums] [font-feature-settings:'tnum'_0]">
                    {s.value}
                  </dd>
                  {s.note && <dd class="text-[11.5px] leading-snug text-ink-muted">{s.note}</dd>}
                </div>
              ))}
            </dl>
          </div>
        </div>
      )}
    </div>
  </div>
</section>
